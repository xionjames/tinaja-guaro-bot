DISCORD_BOT_TOKEN=

# Any OpenAI-compatible server: Ollama (11434), LM Studio (1234), llama.cpp llama-server (8080), Docker Model Runner...
# From inside Docker on a Mac use http://host.docker.internal:<port>/v1
# tinaja-guaro-bot-llm listens on 8080; "default_model" = whatever model the server loaded
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=default_model
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.7

# SQLite file for Notes and TODOs; in Docker mount a volume, e.g. -v ./data:/code/data and DATA_DB=/code/data/bot.db
DATA_DB=bot.db

# The Assistant's personality (system prompt); without the file it's a neutral assistant
PERSONA_FILE=PERSONA.md
